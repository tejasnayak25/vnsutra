{
    "project-name": "vnsutra",
    "version": "1.0.0.0",
    "title": "VN-Sutra",
    "subtitle": "An introduction",
    "icon": "./assets/images/logo.png",
    "poster": "./assets/images/poster.jpg",
    "bgm": "./assets/music/bgm.mp3",
    "support-url": "https://github.com/tejasnayak25/vnsutra",
    "about-url": "https://github.com/tejasnayak25/vnsutra",
    "author": "Tejas Nayak",
    "author-email": "tejasnayak25@outlook.com",
    "description": "An introduction to VN-Sutra, visual novel SDK",
    "copyright": "Copyright - 2024, Tejas Nayak",
    "protocol": "web+vnsutra",
    "screenshots": [
        "./assets/screenshots/screenshot1.png",
        "./assets/screenshots/screenshot2.png",
        "./assets/screenshots/screenshot3.png",
        "./assets/screenshots/screenshot4.png"
    ],
    "fonts": {
        "title": { "name": "LavishlyYours", "url": "./assets/fonts/LavishlyYours/LavishlyYours-Regular.ttf" },
        "other": { "name": "YanoneKaffeesatz", "url": "./assets/fonts/YanoneKaffeesatz/YanoneKaffeesatz-VariableFont_wght.ttf" }
    },
    "gui": {
        "button": null,
        "close-icon": "./assets/svgs/close-square.svg",
        "check-icon": "./assets/svgs/yes.svg",
        "back-icon": "./assets/svgs/back.svg",
        "menu-icon": "./assets/svgs/menu-dots-square.svg",
        "save-icon": "./assets/svgs/save.svg",
        "remove-icon": "./assets/svgs/save-remove.svg",
        "load-icon": "./assets/svgs/load-list-alt.svg",
        "screenshot-icon": "./assets/svgs/screen-capture.svg",
        "expand-icon": "./assets/svgs/expand.svg",
        "add-icon": "./assets/svgs/plus-square.svg",
        "loading-spinner-icon": "./assets/svgs/spinner.svg",
        "settings-icon": "./assets/svgs/settings.svg",
        "group-icon": "./assets/svgs/group.svg",
        "info-icon": "./assets/svgs/info.svg"
    },
    "ui": {
        "xml-mode": false,
        "vnsutra-label": true,
        "portrait-compatible": true,
        "portrait-block-message": "This story supports landscape mode only. Please rotate your device.",
        "disclaimer": {
            "enabled": true,
            "path": "game/disclaimer.md"
        },
        "achievements": {
            "enabled": true
        },
        "locales": {
            "path": "locales/{lang}.json",
            "supported": ["en", "ja", "es", "fr"],
            "fallback": "en"
        },
        "chapters": {
            "enabled": true,
            "mode": "progressive",
            "title": "Chapters",
            "sidebarLabel": "Chapters",
            "path": "game/chapters.json"
        },
        "end": {
            "mode": "credits-then-end",
            "creditsDurationMs": 9000,
            "endHoldMs": 900,
            "allowSkip": true
        },
        "splash": {
            "enabled": true,
            "durationMs": 4000,
            "logos": [
                {
                    "src": "./assets/images/creator-logo.jpeg",
                    "label": "Tejas Nayak"
                },
                {
                    "src": "./assets/images/logo.png",
                    "label": "VN-Sutra"
                }
            ]
        },
        "sidebar": {
            "opacity": 0.8
        },
        "poster": {
            "url": "./assets/images/poster.jpg",
            "opacity": 0.8
        },
        "title": {
            "align": "right",
            "color": "white"
        },
        "mobile": {
            "sidebar": {
                "opacity": 0.9
            },
            "poster": {
                "url": "./assets/images/poster.jpg",
                "opacity": 0.8
            },
            "title": {
                "scale": 1.5
            },
            "poster-offset": 0.33
        }
    },
    "game-ui": {
        "dialog": {
            "title": {
                "skew": -0.2
            },
            "speech": {
                "align": "center"
            }
        }
    },
    "security": {
        "disableDevTools": false,
        "disableContextMenu": false
    },
    "monitoring": {
        "performance": {
            "enabled": true,
            "maxEntries": 120,
            "fpsSampleInterval": 1000,
            "memorySampleInterval": 5000
        },
        "errorTracking": {
            "enableReporting": false,
            "endpoint": "",
            "maxEntries": 100
        }
    },
    "colors": {
        "menu": "#020617",
        "text": "white",
        "menu-border": "grey",
        "primary": "cornflowerblue",
        "secondary": "cyan",
        "primary-text": "white",
        "button": "white",
        "button-text": "black",
        "timestamp-text": "white"
    },
    "credits": {
        "Poster Design": "Image by vandesart from [Pixabay](https://pixabay.com/users/vandesart-39485690/)",
        "Poster-2 Design": "Image by qiaominxu 橋茗旭 from [Pixabay](https://pixabay.com/users/qiaominxu_%e6%a9%8b%e8%8c%97%e6%97%ad-18717949/)",
        "Background Music": "Oleksii Kaplunskyi from [Pixabay](https://pixabay.com/)",
        "Background Artist": "Noraneko Games from [noranekogames.itch.io](https://noranekogames.itch.io/)",
        "Character Artist": "Noraneko Games from [noranekogames.itch.io](https://noranekogames.itch.io/)"
    }
}