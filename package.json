{
  "name": "vnsutra",
  "version": "2.0.0",
  "description": "Modular Visual Novel SDK for the Web",
  "main": "api/index.js",
  "type": "module",
  "keywords": [
    "visual-novel",
    "game-engine",
    "sdk",
    "interactive-fiction"
  ],
  "homepage": "https://github.com/tejasnayak25/vnsutra",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejasnayak25/vnsutra.git"
  },
  "bugs": {
    "url": "https://github.com/tejasnayak25/vnsutra/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node api/prod.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:css\" \"npm run dev:reload\" \"npm run story:watch\"",
    "dev:server": "cross-env NODE_ENV=development nodemon api/dev.js",
    "dev:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "dev:reload": "node dev-server.js",
    "build": "npm run story:build && npm run ui:build && node scripts/build.js",
    "story:build": "node scripts/story-build.js",
    "story:watch": "node scripts/story-build.js --watch",
    "ui:build": "node scripts/ui-build.js",
    "ui:watch": "node scripts/ui-build.js --watch",
    "build:bundle": "npm run build && webpack --config webpack.config.cjs --mode production && node scripts/build-bundle.js",
    "build:bundle:only": "webpack --config webpack.config.cjs --mode production",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "build:prod": "npm run build",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky install"
  },
  "author": "Tejas Nayak <tejasnayak25@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/edge": "^1.2.2",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "daisyui": "^5.0.43",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "flowbite": "^3.1.2",
    "marked": "^17.0.5",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.0",
    "@testing-library/dom": "^9.3.4",
    "chokidar": "^4.0.3",
    "clean-css": "^5.3.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fs-extra": "^11.2.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "terser": "^5.27.0",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "ws": "^8.18.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "cross-env NODE_OPTIONS=--experimental-vm-modules jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
